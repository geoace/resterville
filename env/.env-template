# Rename this to .env if using
ARCGIS_CLIENT_ID=*client id generated in arcgis platform*
ARCGIS_CLIENT_SECRET=*client secret generated in arcgis platform*
ARCGIS_PORTAL_URL=https://arcgis.com/ 
ARCGIS_USER=*AGOL or ArcGIS Enterprise username*
ARCGIS_PASSWORD=your_password
GOOGLE_APPLICATION_CREDENTIALS=/app/env/example_credentials.json
# Use a long random value, e.g. from: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
API_KEY=*long random value*
BUCKET=agol_backups
# Optional
# Extra hosts (comma-separated) that may receive the ArcGIS token, e.g. an Enterprise web adaptor
# host when it differs from ARCGIS_PORTAL_URL. ArcGIS Online and the portal host are always allowed.
ARCGIS_TOKEN_HOSTS=
# INFO by default. DEBUG also logs library request URLs, which can contain tokens.
LOG_LEVEL=INFO
# Read timeout in seconds for ArcGIS and attachment downloads.
HTTP_READ_TIMEOUT=300
